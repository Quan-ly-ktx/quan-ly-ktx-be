# ==============================================================================
# KTX HUB / PDMS - ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# 1. SERVER CONFIGURATION
DEV_PORT=8080
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# 2. POSTGRESQL DATABASE
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dormitory_db
POSTGRES_USER=dorm_user
POSTGRES_PASSWORD=dorm_password
POSTGRES_EXTERNAL_PORT=5432

# 3. REDIS CACHE & OTP
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dorm_redis_pass
REDIS_EXTERNAL_PORT=6379

# 4. SECURITY & JWT (Minimum 256-bit secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# 5. EMAIL SERVICE (OTP Delivery)
MAIL_HOST=localhost
MAIL_PORT=1025
EMAIL_USERNAME=dev
EMAIL_PASSWORD=dev

# 6. CLOUDINARY MEDIA STORAGE (Optional in Dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
